[Unit]
Description=WrkzCoin pool: block unlocker (credits the miners after the coinbase maturity)
After=wrkz-pool-redis.service wrkz-node.service wrkz-wallet-rpc.service
Requires=wrkz-pool-redis.service
[Service]
Type=simple
User=wrkzpool
WorkingDirectory=/opt/wrkz-nodejs-pool
ExecStart=/usr/bin/node /opt/wrkz-nodejs-pool/init.js -module=unlocker
Restart=always
RestartSec=15
TimeoutStopSec=30
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
