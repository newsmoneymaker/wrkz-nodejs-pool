[Unit]
Description=WrkzCoin pool wallet (wallet-service, 127.0.0.1:47857, no password: local use only)
After=wrkz-node.service
Requires=wrkz-node.service

[Service]
Type=simple
User=wrkzpool
ExecStart=/opt/wrkz/bin/wrkz-wallet-api --wallet-file /opt/wrkz/wallet/pool --password-file /opt/wrkz/wallet/password --rpc-bind-ip 127.0.0.1 --rpc-bind-port 47857 --disable-rpc-login --daemon-address 127.0.0.1:17856 --trusted-daemon --log-file /opt/wrkz/wallet/wallet-service.log --max-log-file-size 0
Restart=on-failure
RestartSec=15
TimeoutStopSec=60

[Install]
WantedBy=multi-user.target
