[Unit]
Description=WrkzCoin pool: stratum server (miners, share checking with the wrkzhash helper, block submission)
After=wrkz-pool-redis.service wrkz-node.service wrkz-wallet-rpc.service
Requires=wrkz-pool-redis.service
[Service]
Type=simple
User=wrkzpool
WorkingDirectory=/opt/wrkz-nodejs-pool
ExecStart=/usr/bin/node /opt/wrkz-nodejs-pool/init.js -module=pool
Restart=always
RestartSec=5
TimeoutStopSec=30
NoNewPrivileges=true
PrivateTmp=true
# ports below 1024 need this:
AmbientCapabilities=CAP_NET_BIND_SERVICE

[Install]
WantedBy=multi-user.target
