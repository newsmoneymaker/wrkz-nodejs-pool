[Unit]
Description=WrkzCoin pool: public API (127.0.0.1:8118)
After=wrkz-pool-redis.service wrkz-node.service wrkz-wallet-rpc.service
Requires=wrkz-pool-redis.service
[Service]
Type=simple
User=wrkzpool
WorkingDirectory=/opt/wrkz-nodejs-pool
ExecStart=/usr/bin/node /opt/wrkz-nodejs-pool/init.js -module=api
Restart=always
RestartSec=5
TimeoutStopSec=30
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
